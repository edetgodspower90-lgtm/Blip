# ==============================================================================
# Clerk Configuration (Authentication - Google OAuth & Email/Password)
# Obtain these from: https://dashboard.clerk.com -> API Keys
# ==============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Dashboard -> Webhooks -> Signing secret (endpoint: /api/webhooks/clerk)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"

# Optional: Clerk sign-in/sign-up routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"

# ==============================================================================
# Supabase Configuration (Storage only - media uploads)
# Obtain these from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ==============================================================================
# Prisma & Database Configuration (PostgreSQL / Supabase Transaction & Session Pooler)
# Obtain these from: Supabase Dashboard -> Project Settings -> Database
# ==============================================================================
# Direct connection to the database. Used for Prisma migrations.
DIRECT_URL="postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Connection pooling via Supabase Supavisor (Port 6543) for serverless execution
DATABASE_URL="postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
